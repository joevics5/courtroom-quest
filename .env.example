# =============================================================================
# Courtroom Quest — Environment Variables
# =============================================================================

# --- Supabase (safe to expose client-side — protected by RLS, not secrecy) ---
# Already hardcoded in src/integrations/supabase/client.ts. Listed here for
# reference / in case you move them to env vars instead.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# =============================================================================
# GEMINI — SET AS A SUPABASE SECRET, NOT A FRONTEND ENV VAR
# =============================================================================
# Do NOT put this in Vercel as VITE_GEMINI_API_KEY — that ships it in the
# public JS bundle. Set it as a Supabase secret instead:
#
#   supabase secrets set GEMINI_API_KEY=your-key-here
#
# It's read server-side only, in supabase/functions/ai-generate/index.ts.
# The frontend calls this function via supabase.functions.invoke('ai-generate')
# and never touches Google's API directly. See src/lib/ai/README.md.
#
# GEMINI_API_KEY=your-gemini-key-here   (set via `supabase secrets set`, not here)
